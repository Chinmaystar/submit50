# Backend environment (copy to .env — never commit real values)
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/submit50
REDIS_URL=redis://localhost:6379

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of emails used by the seed script (npm run seed)
ADMIN_EMAILS=admin@acmvnit.org

# Frontend origin(s) for CORS (comma-separated, no trailing slash)
FRONTEND_URL=http://localhost:5173

# COOKIE_SECRET for signing the session cookie (falls back to JWT_SECRET)
COOKIE_SECRET=

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
SUBMIT_RATE_MAX=5
SUBMIT_RATE_WINDOW_MS=60000
RUN_RATE_MAX=15
RUN_RATE_WINDOW_MS=300000
AUTH_RATE_MAX=20
AUTH_RATE_WINDOW_MS=900000

# Trust reverse proxy (Render / nginx) for client IPs + secure cookies
TRUST_PROXY=1
