[Unit]
Description=Submit50 judge worker
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=judge
WorkingDirectory=/opt/submit50/judge
EnvironmentFile=/opt/submit50/judge/.env
ExecStart=/usr/bin/node dist/worker.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/
# Scratch dir for compile/fork work — MUST be host-visible to the Docker
# daemon (PrivateTmp hides /tmp, so we keep it under /var/lib).
ReadWritePaths=/var/lib/submit50
# Allow the sandbox to connect to the host Docker daemon's socket.
SupplementaryGroups=docker

[Install]
WantedBy=multi-user.target