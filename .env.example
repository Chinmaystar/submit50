# =============================================================================
# Submit50 — root environment example (used by docker compose)
# Copy to .env and fill in real values. NEVER commit real secrets.
# Per-package local dev uses backend/.env and judge/.env (see those folders).
# =============================================================================

NODE_ENV=development

# --- Core services -----------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/submit50
REDIS_URL=redis://localhost:6379

# --- API server --------------------------------------------------------------
PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated emails used by the seed script (npm run seed)
ADMIN_EMAILS=admin@acmvnit.org
# Exact origin of the frontend (no trailing slash); comma-separate several
FRONTEND_URL=http://localhost:5173

# --- Rate limits (configurable) ----------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
SUBMIT_RATE_MAX=5
SUBMIT_RATE_WINDOW_MS=60000
RUN_RATE_MAX=15
RUN_RATE_WINDOW_MS=300000
AUTH_RATE_MAX=20
AUTH_RATE_WINDOW_MS=900000

# --- Judge worker -------------------------------------------------------------
# docker | local  (local = insecure dev fallback without Docker; never in prod)
JUDGE_MODE=docker
JUDGE_CONCURRENCY=2
SANDBOX_IMAGE=acm-judge-sandbox:latest
JUDGE_NAME=judge-1
COMPILER_TIMEOUT_S=30
# Seconds of slack given to a test on top of the problem time limit
JUDGE_TIMEOUT_GRACE_S=2
