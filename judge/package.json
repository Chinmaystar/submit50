{
  "name": "submit50-judge",
  "version": "1.0.0",
  "private": true,
  "description": "Submit50 judge worker — executes untrusted submissions inside Docker sandboxes",
  "type": "module",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:malicious": "tsx tests/malicious.ts",
    "test:judge": "tsx tests/judge.integration.ts"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
