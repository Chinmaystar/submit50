# Judge worker environment (copy to .env)
NODE_ENV=production

MONGODB_URI=mongodb://localhost:27017/submit50
REDIS_URL=redis://localhost:6379

# docker = hardened sandbox (required in production)
# local  = host execution, DEV ONLY, refuses to start with NODE_ENV=production
JUDGE_MODE=docker
JUDGE_CONCURRENCY=2
SANDBOX_IMAGE=acm-judge-sandbox:latest
JUDGE_NAME=judge-1

# macOS + Colima: the sandbox spawns `docker --host <DOCKER_HOST>`; Colima does
# not expose /var/run/docker.sock. Example:
# DOCKER_HOST=unix:///Users/you/.colima/default/docker.sock
# Linux / Docker Desktop: leave unset.

# Compiler budget and grace time added on top of each problem's time limit
# (absorbs container startup overhead)
COMPILER_TIMEOUT_S=30
JUDGE_TIMEOUT_GRACE_S=2

# Fork-bomb defense: max processes per sandbox
JUDGE_PIDS_LIMIT=64
# Scratch root for per-job compile dirs (auto-cleaned). MUST be visible to the
# Docker daemon: macOS+Colima only shares $HOME, /tmp does NOT work (mounts as
# an empty dir in the VM). Default on macOS is ~/.submit50-judge-work.
# JUDGE_WORK_DIR=/tmp/submit50-judge-work

LOG_LEVEL=info
